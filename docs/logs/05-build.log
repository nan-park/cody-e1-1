## 8) 컨테이너 실행 (포트 매핑 없이)
$ docker run -d --name web-nomap cody-web:1.0
9eb69d4519ad68550ba3286b91145e267532c2b33854f0a787432a20b854bb94

$ docker ps --format "table {{.Names}}	{{.Status}}	{{.Ports}}"
NAMES       STATUS                                     PORTS
web-nomap   Up Less than a second (health: starting)   80/tcp, 8080/tcp

## 9) 헬스체크 상태 확인
$ docker ps --format "table {{.Names}}	{{.Status}}"
NAMES       STATUS
web-nomap   Up 30 seconds (healthy)

$ docker inspect web-nomap --format "Health={{.State.Health.Status}} / 마지막검사={{(index .State.Health.Log 0).ExitCode}}"
Health=healthy / 마지막검사=0

## 10) 컨테이너 '안'에서는 접속되는가
$ docker exec web-nomap wget -qO- http://127.0.0.1:8080/healthz
ok

$ docker exec web-nomap wget -qO- http://127.0.0.1:8080/env
APP_ENV=dev
NGINX_PORT=8080

$ docker exec web-nomap sh -c "wget -qO- http://127.0.0.1:8080/ | head -12"
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
